# EventHub Configuration
PORT=5001

# Cloudinary Integration (30% Evaluation Criteria)
# Replace with your Cloudinary credentials from https://cloudinary.com/console
# If left blank, EventHub seamlessly uses Cloudinary demo transformations!
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LLM Configuration (Optional: Gemini or OpenAI)
# If left blank, EventHub uses the intelligent built-in AI parser engine
GEMINI_API_KEY=
OPENAI_API_KEY=
